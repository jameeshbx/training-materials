generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  createdAt   DateTime    @default(now())
  teamId      String?
  password    String
  role        Role        @default(USER)
  tasks       Task[]
  timeEntries TimeEntry[]
  team        Team?       @relation(fields: [teamId], references: [id])
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      String      @default("pending")
  dueDate     DateTime?
  userId      String
  teamId      String?
  createdAt   DateTime    @default(now())
  team        Team?       @relation(fields: [teamId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  timeEntries TimeEntry[]
}

model Team {
  id    String @id @default(cuid())
  name  String
  tasks Task[]
  users User[]
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  createdAt DateTime  @default(now())
  endTime   DateTime?
  startTime DateTime
  userId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}
