generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  teamId    String?
  password  String
  role      Role     @default(USER)

  attachments Attachment[]

  // The tasks created by this user
  tasks Task[] @relation("UserCreatedTasks")

  // Tasks assigned to this user
  assignedTasks Task[] @relation("UserAssignedTasks")

  timeEntries TimeEntry[]
  team        Team?       @relation(fields: [teamId], references: [id])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  status      String  @default("pending")

  // Creator
  userId String
  user   User   @relation("UserCreatedTasks", fields: [userId], references: [id])

  // Assignee
  assigneeId String?
  assignee   User?   @relation("UserAssignedTasks", fields: [assigneeId], references: [id])

  teamId        String?
  createdAt     DateTime  @default(now())
  dueDate       DateTime?
  attachmentUrl String?

  team        Team?       @relation(fields: [teamId], references: [id])
  timeEntries TimeEntry[]
}

model Team {
  id    String @id @default(cuid())
  name  String
  tasks Task[]
  users User[]
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  createdAt DateTime  @default(now())
  endTime   DateTime?
  startTime DateTime
  userId    String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Attachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}
