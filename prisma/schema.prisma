generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?  // Made optional temporarily to handle existing users
  role      Role     @default(USER)
  teamId    String?
  createdAt DateTime @default(now())
  tasks     Task[]
  team      Team?    @relation(fields: [teamId], references: [id])
  timeEntries TimeEntry[]
  auditLogs AuditLog[]
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      String      @default("pending")
  userId      String
  teamId      String?
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  team        Team?       @relation(fields: [teamId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  timeEntries TimeEntry[]
}

model Team {
  id    String @id @default(cuid())
  name  String
  tasks Task[]
  users User[]
  invites Invite[]

}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  hours     Float? @default(0)

  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}


model Activity {
  id          String   @id @default(cuid())
  type        String
  userId      String
  activityText String? 
  userName    String
  teamId      String?
  taskId      String?
  taskTitle   String?
  documentName String?
  hours       Float?
  timestamp   DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  title     String?
  fileName  String?
  url       String
  createdAt DateTime @default(now())
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  invitedBy String   // userId of the person who sent invite
  status    String   @default("PENDING") // PENDING | ACCEPTED | CANCELLED
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  
}
model AuditLog {
  id         String   @id @default(cuid())

  action     String        // e.g. "TASK_CREATED", "TASK_DELETED"
  userId     String?       // who did this action
  user       User?   @relation(fields: [userId], references: [id])

  targetType String?       // e.g. "TASK", "INVITE", "TEAM"
  targetId   String?       // ID of that thing
  userName  String? 

  meta       Json?         // extra details, like { "title": "Task 1" }

  createdAt  DateTime @default(now())
}

